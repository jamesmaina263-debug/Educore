# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project: Educore (org: oifyxuujtmiqhokfcatv, region: eu-central-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: server-side only, never exposed to the client/browser.
# Used only in Edge Functions / server actions that must bypass RLS deliberately.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key — used only for drafting report card comments (always a
# suggestion, never shown to a parent until a teacher approves it). Free tier,
# no credit card required: create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Africa's Talking SMS credentials -- duplicated here on purpose. The
# ZKTeco/ADMS route (/iclock/cdata) runs on Vercel/Node and sends guardian
# SMS itself (src/lib/sms), separately from the Supabase Edge Function copy
# (supabase/functions/_shared/sms) that the kiosk path uses. Same values as
# the Edge Function secrets -- see SECRETS_ROTATION_POLICY.md. Currently
# sandbox credentials (AT_USERNAME=sandbox), which only deliver to Africa's
# Talking's Sandbox Simulator, not real phones.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Set to "true" only in local/preview environments to let src/lib/sms fall
# back to logging "would send SMS" instead of throwing when AT_USERNAME/
# AT_API_KEY aren't set. Leave unset in production -- see
# src/lib/sms/devFallbackGuard.ts for why an unconfigured provider must
# fail loudly, not silently pretend to send.
ALLOW_CONSOLE_FALLBACK=

# Edge Function CORS allowlist: comma-separated production/staging origins that
# are allowed to call request-otp, verify-otp, send-communication, and api-v1
# from a browser (e.g. "https://app.educore.co.ke,https://educore-staging.vercel.app").
# Set as a Supabase secret, not a Next.js env var:
#   supabase secrets set ALLOWED_ORIGINS=https://app.educore.co.ke
# Leaving this unset rejects every cross-origin browser request (fails closed).
ALLOWED_ORIGINS=
