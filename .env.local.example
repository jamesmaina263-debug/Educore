# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project: Educore (org: oifyxuujtmiqhokfcatv, region: eu-central-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key: server-side only, never exposed to the client/browser.
# Used only in Edge Functions / server actions that must bypass RLS deliberately.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key — used only for drafting report card comments (always a
# suggestion, never shown to a parent until a teacher approves it). Free tier,
# no credit card required: create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Edge Function CORS allowlist: comma-separated production/staging origins that
# are allowed to call request-otp, verify-otp, send-communication, and api-v1
# from a browser (e.g. "https://app.educore.co.ke,https://educore-staging.vercel.app").
# Set as a Supabase secret, not a Next.js env var:
#   supabase secrets set ALLOWED_ORIGINS=https://app.educore.co.ke
# Leaving this unset rejects every cross-origin browser request (fails closed).
ALLOWED_ORIGINS=

# Marketing site analytics (GA4) — see src/lib/ga4.ts. Stays a safe no-op
# until both are set: every ga4.ts function returns null, and the Analytics
# & Marketing admin console shows a "not connected" state instead of any
# numbers. (A separate, cookie-less Plausible integration used to live here
# too, but it was never activated and was removed rather than finished --
# GA4 is the dashboard's live data source.)
#
# The GA4 property ID (Admin -> Property Settings in Google Analytics).
GA4_PROPERTY_ID=
# Full service-account key JSON (one line), granted Viewer access on the
# GA4 property (Admin -> Property Access Management).
GOOGLE_SERVICE_ACCOUNT_JSON=

# Cloudflare Turnstile (Managed mode) — mandatory CAPTCHA on /signup, see
# src/components/turnstile-widget.tsx (client) and src/lib/turnstile.ts
# (server-side verification, which fails closed if this is unset).
#
# Public: safe to expose client-side, renders the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-side only, never exposed to the browser.
TURNSTILE_SECRET_KEY=

# Optional: Slack Incoming Webhook URL for security alerts (rate-limit
# trips, rejected M-Pesa callback IP/token, rejected Twilio WhatsApp
# signatures) -- see src/lib/security-alert.ts. If unset, alerts are simply
# skipped; nothing else depends on this. Same variable name must also be
# set as a Supabase Edge Function secret (`supabase secrets set
# SECURITY_ALERT_WEBHOOK_URL=...`) for the mpesa-stk-callback,
# whatsapp-webhook, and request-otp functions to alert too.
SECURITY_ALERT_WEBHOOK_URL=
